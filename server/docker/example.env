# Settings for compose.yaml: copy this to .env next to it and fill it in. .env holds the room's
# token and password: keep it out of git. A value runs to the end of its line; Compose replaces
# $NAME and ${NAME} in it, so put a value with a $ in single quotes: ROOM_PASSWORD='pa$$word'

# The address players reach this server at (its public IP or a host name)
PUBLIC_ADDRESS=

# open: a name belongs to whoever signs in with it first; invite: only names you add
LOBBY_MODE=open
LOBBY_PORT=24872

ROOM_NAME=MH4U Gathering Hall
ROOM_DESCRIPTION=
ROOM_PORT=24872
ROOM_PASSWORD=
ROOM_MAX_MEMBERS=16

# The room's own name and token in the lobby, to be listed there. The lobby shows that name as
# the room's owner, and Azahar at the port's pinned commit makes a player who joins with it as
# nickname the room's moderator: read "Moderators" in docs/SERVER.md before you choose one.
# Open mode: the first use claims the name, so pick a long random token. Invite mode: first run
#   docker compose exec lobby mh4u-lobby add-user "<the name>"
# and put the token it prints here, then: docker compose up -d room
LOBBY_USERNAME=
LOBBY_TOKEN=
