+    // the port's further views of parts of the bottom screen are drawn over everything else: a
+    // new touch on one is a touch on its part (a touch moving from elsewhere stays there)
+    const int view = framebuffer_layout.BottomViewAt(framebuffer_x, framebuffer_y);
+    {
+        std::scoped_lock guard(touch_state->mutex);
+        if (view >= 0 && (!touch_state->touch_pressed || touch_state->view >= 0)) {
+            TouchInView(*touch_state, framebuffer_layout, view, framebuffer_x, framebuffer_y);
+            return true;
+        }
+        if (framebuffer_layout.IsWithinTouchscreen(framebuffer_x, framebuffer_y)) {
+            touch_state->view = -1;
+        }
+    }
     if (!framebuffer_layout.IsWithinTouchscreen(framebuffer_x, framebuffer_y))
         return false;
     Settings::StereoRenderOption render_3d_mode = get3DMode();
