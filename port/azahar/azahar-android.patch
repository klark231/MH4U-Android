+/// A screen, or a part of one (`shape`: its size), `fraction` times the window's height at its
+/// aspect ratio, placed at (x, y): fractions of the room the window leaves beside and above it.
+static Common::Rectangle<u32> PlaceInWindow(u32 width, u32 height,
+                                            const Common::Rectangle<u32>& shape, float fraction,
+                                            float x, float y) {
+    const u32 h = std::min(height, std::max(1u, static_cast<u32>(std::lround(height * fraction))));
+    const u32 w = std::min(width, std::max(1u, h * shape.GetWidth() / shape.GetHeight()));
+    const u32 left = static_cast<u32>(std::lround(std::clamp(x, 0.0f, 1.0f) * (width - w)));
+    const u32 top = static_cast<u32>(std::lround(std::clamp(y, 0.0f, 1.0f) * (height - h)));
+    return {left, top, left + w, top + h};
+}
