+/// The custom layout with a screen overlay (see SetScreenOverlay): the main screen as large as
+/// the window allows at its aspect ratio, centred, and the other one over it in a corner (or
+/// where the overlay places it), with the overlay's further views of the bottom screen.
+static FramebufferLayout OverlayFrameLayout(u32 width, u32 height, bool is_swapped,
+                                            const ScreenOverlay& overlay) {
+    const bool upright = Settings::values.upright_screen.GetValue();
+    if (upright) {
+        std::swap(width, height);
+    }
+    FramebufferLayout res{width, height, true, true, {}, {}, !upright, false};
+    const Common::Rectangle<u32> top{0, 0, TopScreenWidth(), Core::kScreenTopHeight};
+    const Common::Rectangle<u32> bottom{0, 0, Core::kScreenBottomWidth,
+                                        Core::kScreenBottomHeight};
+    // the crop applies to the bottom screen in the corner, in landscape orientation
+    const bool cropped = !is_swapped && !upright;
+    const Common::Rectangle<float> crop =
+        cropped ? Common::Rectangle<float>{overlay.crop_left, overlay.crop_top, overlay.crop_right,
+                                           overlay.crop_bottom}
+                : Common::Rectangle<float>{0.0f, 0.0f, 1.0f, 1.0f};
+    const Common::Rectangle<u32> bottom_part = BottomPart(crop);
+    const auto& main = is_swapped ? bottom : top;
+    const auto& small = is_swapped ? top : bottom_part;
+
+    Common::Rectangle<u32> big = MaxRectangle(Common::Rectangle<u32>{0, 0, width, height}, main);
+    big = big.TranslateX((width - big.GetWidth()) / 2).TranslateY((height - big.GetHeight()) / 2);
+
+    using Corner = ScreenOverlay::Corner;
+    const bool placed = overlay.x >= 0.0f && overlay.y >= 0.0f;
+    const bool left = overlay.corner == Corner::TopLeft || overlay.corner == Corner::BottomLeft;
+    const bool up = overlay.corner == Corner::TopLeft || overlay.corner == Corner::TopRight;
+    const float x = placed ? overlay.x : left ? 0.0f : 1.0f;
+    const float y = placed ? overlay.y : up ? 0.0f : 1.0f;
+    const Common::Rectangle<u32> corner = PlaceInWindow(width, height, small, overlay.height, x, y);
+
+    res.top_screen = is_swapped ? corner : big;
+    res.bottom_screen = is_swapped ? big : corner;
+    res.bottom_crop = crop;
+    if (cropped) {
+        // further parts of the bottom screen, each where it is placed
+        for (const auto& view : overlay.views) {
+            if (view.height <= 0.0f || res.bottom_view_count >= res.bottom_views.size()) {
+                continue;
+            }
+            const Common::Rectangle<float> part{view.crop_left, view.crop_top, view.crop_right,
+                                                view.crop_bottom};
+            res.bottom_views[res.bottom_view_count++] = {
+                PlaceInWindow(width, height, BottomPart(part), view.height, view.x, view.y), part};
+        }
+    }
+    (is_swapped ? res.top_opacity : res.bottom_opacity) = overlay.opacity;
+    return upright ? reverseLayout(res) : res;
+}
