+/// A touch at (x, y) in the layout's further view `view` of the bottom screen (the port's quest
+/// HUD), with the state's lock held: the point in that view's part of the bottom screen.
+static void TouchInView(EmuWindow::TouchState& state, const Layout::FramebufferLayout& layout,
+                        int view, unsigned x, unsigned y) {
+    const auto& [r, crop] = layout.bottom_views[view];
+    x = std::clamp(x, r.left, std::max(r.left, r.right - 1));
+    y = std::clamp(y, r.top, std::max(r.top, r.bottom - 1));
+    const float fx = static_cast<float>(x - r.left) / std::max(1u, r.GetWidth());
+    const float fy = static_cast<float>(y - r.top) / std::max(1u, r.GetHeight());
+    state.touch_x = crop.left + fx * (crop.right - crop.left);
+    state.touch_y = crop.top + fy * (crop.bottom - crop.top);
+    state.touch_pressed = true;
+    state.view = view;
+}
+
