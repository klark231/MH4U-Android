     }
 
+    // a bottom screen showing only part of itself (the port's touch-screen overlay)
+    const auto& crop = framebuffer_layout.bottom_crop;
+    touch_state->touch_x = crop.left + touch_state->touch_x * (crop.right - crop.left);
